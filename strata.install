<?php

/**
 * @file
 * Install, schema and requirements hooks for Strata.
 */

declare(strict_types=1);

use Drupal\Core\Database\Statement\FetchAs;
use Drupal\Core\Extension\Requirement\RequirementSeverity;
use Drupal\Core\StringTranslation\TranslatableMarkup;
use Drupal\strata\Codec\CodecCatalog;
use Drupal\strata\Codec\CodecProfile;
use Drupal\strata\Codec\CodecRegistry;

/**
 * Implements hook_schema().
 *
 * Every table here is derived state. The commit log, the trees, the frames and the segments all
 * live in the object store; these tables are an index over them so a page load does not have to
 * list a bucket. `drush strata:reindex` rebuilds all of it from the store, which is what makes it
 * safe for an uninstall to drop them.
 *
 * Two tables are the exception and are exported by hook_uninstall() before the drop, because
 * nothing in the bucket can reproduce them: strata_restore_log records who restored what, and
 * strata_health records what went wrong and when.
 */
function strata_schema(): array
{
	$schema = [];

	$schema['strata_journal'] = [
		'description' => 'Captured operations waiting to be flushed into a segment.',
		'fields' => [
			'sequence' => [
				'type' => 'serial',
				'size' => 'big',
				'not null' => true,
				'description' => 'Monotonic capture order.',
			],
			'microtime' => [
				'type' => 'int',
				'size' => 'big',
				'not null' => true,
				'description' => 'Unix microseconds the operation was captured at.',
			],
			'realm' => [
				'type' => 'varchar',
				'length' => 16,
				'not null' => true,
				'description' => 'Realm value from the Realm enum.',
			],
			'subject' => [
				'type' => 'varchar',
				'length' => 255,
				'not null' => true,
				'description' => 'What changed, such as node:42 or system.site.',
			],
			'verb' => [
				'type' => 'varchar',
				'length' => 16,
				'not null' => true,
				'description' => 'Verb value from the Verb enum.',
			],
			'actor' => [
				'type' => 'int',
				'unsigned' => true,
				'not null' => false,
				'description' => 'Drupal user id responsible, or NULL for unattended work.',
			],
			'request_id' => [
				'type' => 'varchar',
				'length' => 64,
				'not null' => false,
				'description' => 'Groups operations captured in one request.',
			],
			'payload_hash' => [
				'type' => 'varchar',
				'length' => 64,
				'not null' => false,
				'description' => 'Content address of the captured value.',
			],
			'parent_hash' => [
				'type' => 'varchar',
				'length' => 64,
				'not null' => false,
				'description' => 'Content address of the value this one replaces.',
			],
			'payload_length' => [
				'type' => 'int',
				'unsigned' => true,
				'not null' => true,
				'default' => 0,
				'description' => 'Decoded length of the captured value.',
			],
			'label' => [
				'type' => 'varchar',
				'length' => 255,
				'not null' => true,
				'default' => '',
				'description' => 'Human summary shown in the timeline.',
			],
			'fields' => [
				'type' => 'text',
				'size' => 'normal',
				'not null' => false,
				'description' => 'JSON list of changed top-level field names.',
			],
			'payload' => [
				'type' => 'blob',
				'size' => 'big',
				'not null' => false,
				'description' => 'The captured value, held until the flush stores it.',
			],
		],
		'primary key' => ['sequence'],
		'indexes' => [
			'microtime' => ['microtime'],
			'realm_subject' => ['realm', 'subject'],
			'request' => ['request_id'],
		],
	];

	$schema['strata_commit'] = [
		'description' => 'Index over the commits in the object store.',
		'fields' => [
			'id' => [
				'type' => 'varchar',
				'length' => 64,
				'not null' => true,
				'description' => 'Commit content address.',
			],
			'parent' => [
				'type' => 'varchar',
				'length' => 64,
				'not null' => false,
				'description' => 'Parent commit, or NULL for the root of history.',
			],
			'merge_parent' => [
				'type' => 'varchar',
				'length' => 64,
				'not null' => false,
				'description' =>
					'Second parent a merge brought in, or NULL for every other commit.',
			],
			'index_ref' => [
				'type' => 'varchar',
				'length' => 64,
				'not null' => true,
				'description' => 'Base anchor address this commit resolves against.',
			],
			'microtime' => [
				'type' => 'int',
				'size' => 'big',
				'not null' => true,
				'description' => 'Unix microseconds the commit was sealed at.',
			],
			'label' => [
				'type' => 'varchar',
				'length' => 255,
				'not null' => true,
				'default' => '',
				'description' => 'Human summary of what the commit covers.',
			],
			'actor' => [
				'type' => 'int',
				'unsigned' => true,
				'not null' => false,
				'description' => 'Drupal user id responsible, or NULL.',
			],
			'operations' => [
				'type' => 'int',
				'unsigned' => true,
				'not null' => true,
				'default' => 0,
				'description' => 'Operations the commit covers.',
			],
			'raw_bytes' => [
				'type' => 'int',
				'size' => 'big',
				'unsigned' => true,
				'not null' => true,
				'default' => 0,
				'description' => 'Decoded bytes the operations describe.',
			],
			'stored_bytes' => [
				'type' => 'int',
				'size' => 'big',
				'unsigned' => true,
				'not null' => true,
				'default' => 0,
				'description' => 'Bytes written after dedup, compression and sealing.',
			],
			'level' => [
				'type' => 'int',
				'unsigned' => true,
				'not null' => true,
				'default' => 0,
				'description' => 'Compaction level.',
			],
			'is_base' => [
				'type' => 'int',
				'size' => 'tiny',
				'not null' => true,
				'default' => 0,
				'description' => 'Whether this commit wrote the anchor it names.',
			],
			'chain' => [
				'type' => 'int',
				'unsigned' => true,
				'not null' => true,
				'default' => 0,
				'description' =>
					'Anchors between this commit\'s anchor and the full one behind it.',
			],
			'anchored_at' => [
				'type' => 'int',
				'size' => 'big',
				'not null' => true,
				'default' => 0,
				'description' => 'Unix microseconds the anchor this commit names was written at.',
			],
			'segment_key' => [
				'type' => 'varchar',
				'length' => 255,
				'not null' => false,
				'description' => 'Object key of the segment this commit sealed.',
			],
		],
		'primary key' => ['id'],
		'indexes' => [
			'microtime' => ['microtime'],
			'parent' => ['parent'],
			'merge_parent' => ['merge_parent'],
			'level_microtime' => ['level', 'microtime'],
			'base' => ['is_base', 'microtime'],
		],
	];

	$schema['strata_branch'] = [
		'description' => 'Index over the config branches the object store holds.',
		'fields' => [
			'name' => [
				'type' => 'varchar',
				'length' => 128,
				'not null' => true,
				'description' => 'Branch name, which is the ref segment under refs/heads/.',
			],
			'forked_from' => [
				'type' => 'varchar',
				'length' => 64,
				'not null' => true,
				'description' => 'Commit the branch was cut from.',
			],
			'tip' => [
				'type' => 'varchar',
				'length' => 64,
				'not null' => true,
				'description' => 'Commit the branch currently points at.',
			],
			'actor' => [
				'type' => 'int',
				'unsigned' => true,
				'not null' => false,
				'description' => 'Drupal user id that created it, or NULL.',
			],
			'created' => [
				'type' => 'int',
				'size' => 'big',
				'not null' => true,
				'default' => 0,
				'description' => 'Unix microseconds the branch was created at.',
			],
		],
		'primary key' => ['name'],
		'indexes' => [
			'created' => ['created'],
			'forked_from' => ['forked_from'],
		],
	];

	$schema['strata_subject'] = [
		'description' =>
			'Where every subject was last stored, so an anchor and a delta both read nothing.',
		'fields' => [
			'subject' => [
				'type' => 'varchar',
				'length' => 255,
				'not null' => true,
				'description' => 'Realm-qualified subject path.',
			],
			'frames' => [
				'type' => 'text',
				'size' => 'medium',
				'not null' => true,
				'description' => 'JSON list of frame addresses that reconstruct the subject.',
			],
			'size' => [
				'type' => 'int',
				'size' => 'big',
				'unsigned' => true,
				'not null' => true,
				'default' => 0,
				'description' => 'Decoded bytes the subject occupies.',
			],
			'deleted' => [
				'type' => 'int',
				'size' => 'tiny',
				'not null' => true,
				'default' => 0,
				'description' => 'Whether the subject was removed rather than written.',
			],
			'updated' => [
				'type' => 'int',
				'size' => 'big',
				'not null' => true,
				'default' => 0,
				'description' => 'Unix microseconds the subject last changed.',
			],
		],
		'primary key' => ['subject'],
		'indexes' => [
			'updated' => ['updated'],
		],
	];

	$schema['strata_frame'] = [
		'description' => 'Deduplication and reference index over stored frames.',
		'fields' => [
			'hash' => [
				'type' => 'varchar',
				'length' => 64,
				'not null' => true,
				'description' => 'Content address of the decoded frame.',
			],
			'raw_size' => [
				'type' => 'int',
				'unsigned' => true,
				'not null' => true,
				'default' => 0,
				'description' => 'Decoded size in bytes.',
			],
			'stored_size' => [
				'type' => 'int',
				'unsigned' => true,
				'not null' => true,
				'default' => 0,
				'description' => 'Encoded size after compression and sealing.',
			],
			'codec' => [
				'type' => 'varchar',
				'length' => 16,
				'not null' => true,
				'description' => 'Codec id the frame was compressed with.',
			],
			'cipher' => [
				'type' => 'varchar',
				'length' => 32,
				'not null' => true,
				'description' => 'Cipher id the frame was sealed with.',
			],
			'dictionary' => [
				'type' => 'varchar',
				'length' => 64,
				'not null' => false,
				'description' => 'Dictionary id the codec needs, or NULL.',
			],
			'pack' => [
				'type' => 'varchar',
				'length' => 64,
				'not null' => false,
				'description' => 'Pack the frame lives inside, or NULL when standalone.',
			],
			'offset' => [
				'type' => 'int',
				'unsigned' => true,
				'not null' => true,
				'default' => 0,
				'description' => 'Byte offset within the pack.',
			],
			'refs' => [
				'type' => 'int',
				'unsigned' => true,
				'not null' => true,
				'default' => 0,
				'description' => 'How many segments, trees or file maps point at this frame.',
			],
			'created' => [
				'type' => 'int',
				'not null' => true,
				'default' => 0,
				'description' => 'Unix timestamp the frame was first stored.',
			],
			'delta_parent' => [
				'type' => 'varchar',
				'length' => 64,
				'not null' => false,
				'description' => 'Frame this one is a delta against, or NULL when it stands alone.',
			],
			'delta_depth' => [
				'type' => 'int',
				'unsigned' => true,
				'not null' => true,
				'default' => 0,
				'description' => 'Position in the delta chain; zero for an anchor.',
			],
		],
		'primary key' => ['hash'],
		'indexes' => [
			'pack' => ['pack'],
			'orphans' => ['refs'],
			'dictionary' => ['dictionary'],
			'delta_parent' => ['delta_parent'],
		],
	];

	$schema['strata_dict'] = [
		'description' => 'Index over the per-realm compression dictionaries in the store.',
		'fields' => [
			'id' => [
				'type' => 'varchar',
				'length' => 96,
				'not null' => true,
				'description' => 'Realm and version, as every frame records it.',
			],
			'realm' => [
				'type' => 'varchar',
				'length' => 32,
				'not null' => true,
				'description' => 'Realm the dictionary was trained for.',
			],
			'version' => [
				'type' => 'int',
				'unsigned' => true,
				'not null' => true,
				'description' => 'Version, counting from one.',
			],
			'address' => [
				'type' => 'varchar',
				'length' => 64,
				'not null' => true,
				'description' => 'Content address of the dictionary bytes.',
			],
			'bytes' => [
				'type' => 'int',
				'unsigned' => true,
				'not null' => true,
				'default' => 0,
				'description' => 'How large the dictionary is.',
			],
			'source' => [
				'type' => 'varchar',
				'length' => 16,
				'not null' => true,
				'default' => 'raw',
				'description' => 'Whether it was concatenated or trained by the zstd binary.',
			],
			'ratio' => [
				'type' => 'float',
				'not null' => true,
				'default' => 1,
				'description' => 'Compression ratio measured on the samples it was scored against.',
			],
			'samples' => [
				'type' => 'int',
				'unsigned' => true,
				'not null' => true,
				'default' => 0,
				'description' => 'How many samples it was built from.',
			],
			'trained_at' => [
				'type' => 'int',
				'not null' => true,
				'default' => 0,
				'description' => 'Unix seconds the dictionary was trained at.',
			],
		],
		'primary key' => ['id'],
		'indexes' => [
			'realm_version' => ['realm', 'version'],
		],
	];

	$schema['strata_lock'] = [
		'description' => 'Leases that keep two flushes or compactions from overlapping.',
		'fields' => [
			'name' => [
				'type' => 'varchar',
				'length' => 64,
				'not null' => true,
				'description' => 'Lease name.',
			],
			'holder' => [
				'type' => 'varchar',
				'length' => 64,
				'not null' => true,
				'description' => 'Opaque token identifying the holder.',
			],
			'expires' => [
				'type' => 'int',
				'not null' => true,
				'description' => 'Unix timestamp the lease expires at.',
			],
		],
		'primary key' => ['name'],
		'indexes' => ['expires' => ['expires']],
	];

	$schema['strata_restore_log'] = [
		'description' => 'Audit of every restore. Exported before an uninstall drops it.',
		'fields' => [
			'id' => ['type' => 'serial', 'not null' => true, 'description' => 'Row id.'],
			'started' => [
				'type' => 'int',
				'not null' => true,
				'description' => 'Unix timestamp the restore began.',
			],
			'finished' => [
				'type' => 'int',
				'not null' => false,
				'description' => 'Unix timestamp it ended, or NULL while running.',
			],
			'actor' => [
				'type' => 'int',
				'unsigned' => true,
				'not null' => false,
				'description' => 'Drupal user id who ran it.',
			],
			'target' => [
				'type' => 'varchar',
				'length' => 64,
				'not null' => true,
				'description' => 'Commit the restore targeted.',
			],
			'pre_snapshot' => [
				'type' => 'varchar',
				'length' => 64,
				'not null' => false,
				'description' => 'Commit taken before the restore, so it can be undone.',
			],
			'scope' => [
				'type' => 'varchar',
				'length' => 255,
				'not null' => true,
				'description' => 'What the restore was scoped to.',
			],
			'mode' => [
				'type' => 'varchar',
				'length' => 16,
				'not null' => true,
				'description' => 'Either logical or physical.',
			],
			'outcome' => [
				'type' => 'varchar',
				'length' => 16,
				'not null' => true,
				'description' => 'One of pending, succeeded, failed or refused.',
			],
			'restored' => [
				'type' => 'int',
				'unsigned' => true,
				'not null' => true,
				'default' => 0,
				'description' => 'Subjects restored.',
			],
			'skipped' => [
				'type' => 'int',
				'unsigned' => true,
				'not null' => true,
				'default' => 0,
				'description' => 'Subjects left alone because they were degraded.',
			],
			'detail' => [
				'type' => 'text',
				'size' => 'big',
				'not null' => false,
				'description' => 'JSON manifest of what changed.',
			],
		],
		'primary key' => ['id'],
		'indexes' => [
			'started' => ['started'],
			'target' => ['target'],
			'outcome' => ['outcome'],
		],
	];

	$schema['strata_health'] = [
		'description' => 'Findings the tripwires raised. Exported before an uninstall drops it.',
		'fields' => [
			'id' => ['type' => 'serial', 'not null' => true, 'description' => 'Row id.'],
			'code' => [
				'type' => 'varchar',
				'length' => 64,
				'not null' => true,
				'description' => 'Stable dotted finding code.',
			],
			'severity' => [
				'type' => 'int',
				'size' => 'tiny',
				'not null' => true,
				'description' => 'Finding severity ordinal.',
			],
			'scope' => [
				'type' => 'varchar',
				'length' => 128,
				'not null' => true,
				'default' => '',
				'description' => 'What the finding was about.',
			],
			'context' => [
				'type' => 'varchar',
				'length' => 400,
				'not null' => true,
				'default' => '',
				'description' => 'Short human detail, truncated on write.',
			],
			'rung' => [
				'type' => 'varchar',
				'length' => 16,
				'not null' => true,
				'default' => 'observe',
				'description' => 'Current repair rung for this code.',
			],
			'created' => [
				'type' => 'int',
				'not null' => true,
				'description' => 'Unix timestamp the finding was recorded.',
			],
			'resolved' => [
				'type' => 'int',
				'not null' => false,
				'description' => 'Unix timestamp it was resolved, or NULL while open.',
			],
		],
		'primary key' => ['id'],
		'indexes' => [
			'code_created' => ['code', 'created'],
			'open' => ['resolved', 'severity'],
		],
	];

	$schema['strata_watermark'] = [
		'description' => 'Per-table watermarks the reconciler compares against to detect drift.',
		'fields' => [
			'table_name' => [
				'type' => 'varchar',
				'length' => 128,
				'not null' => true,
				'description' => 'The table being watched.',
			],
			'row_count' => [
				'type' => 'int',
				'size' => 'big',
				'unsigned' => true,
				'not null' => true,
				'default' => 0,
				'description' => 'Row count at the last check.',
			],
			'max_key' => [
				'type' => 'varchar',
				'length' => 64,
				'not null' => false,
				'description' => 'Highest primary key seen.',
			],
			'max_changed' => [
				'type' => 'int',
				'not null' => false,
				'description' => 'Highest changed timestamp seen.',
			],
			'digest' => [
				'type' => 'varchar',
				'length' => 64,
				'not null' => false,
				'description' => 'Sampled digest of the table contents.',
			],
			'checked' => [
				'type' => 'int',
				'not null' => true,
				'description' => 'Unix timestamp of the last check.',
			],
		],
		'primary key' => ['table_name'],
		'indexes' => ['checked' => ['checked']],
	];

	$schema['strata_classification'] = [
		'description' => 'How each discovered ephemeral namespace is classified.',
		'fields' => [
			'pattern' => [
				'type' => 'varchar',
				'length' => 255,
				'not null' => true,
				'description' => 'Glob matching the keys this rule covers.',
			],
			'classification' => [
				'type' => 'varchar',
				'length' => 16,
				'not null' => true,
				'description' => 'One of authoritative, derivable or unclassified.',
			],
			'source' => [
				'type' => 'varchar',
				'length' => 16,
				'not null' => true,
				'description' => 'Either heuristic or human.',
			],
			'keys_seen' => [
				'type' => 'int',
				'unsigned' => true,
				'not null' => true,
				'default' => 0,
				'description' => 'Keys observed under this pattern.',
			],
			'bytes_seen' => [
				'type' => 'int',
				'size' => 'big',
				'unsigned' => true,
				'not null' => true,
				'default' => 0,
				'description' => 'Bytes observed under this pattern.',
			],
			'decided' => [
				'type' => 'int',
				'not null' => true,
				'description' => 'Unix timestamp the classification was set.',
			],
		],
		'primary key' => ['pattern'],
		'indexes' => ['classification' => ['classification']],
	];

	$schema['strata_provider_stat'] = [
		'description' => 'What each storage provider was asked to do, accumulated per day.',
		'fields' => [
			'provider' => [
				'type' => 'varchar',
				'length' => 64,
				'not null' => true,
				'description' => 'Provider id.',
			],
			'day' => [
				'type' => 'int',
				'not null' => true,
				'description' => 'Unix timestamp of the day this row accumulates, at midnight UTC.',
			],
			'operation' => [
				'type' => 'varchar',
				'length' => 16,
				'not null' => true,
				'description' => 'One of put, get, head, list or delete.',
			],
			'requests' => [
				'type' => 'int',
				'unsigned' => true,
				'not null' => true,
				'default' => 0,
				'description' => 'Requests performed.',
			],
			'failures' => [
				'type' => 'int',
				'unsigned' => true,
				'not null' => true,
				'default' => 0,
				'description' => 'Requests that did not succeed.',
			],
			'bytes' => [
				'type' => 'int',
				'size' => 'big',
				'unsigned' => true,
				'not null' => true,
				'default' => 0,
				'description' => 'Bytes transferred.',
			],
			'seconds' => [
				'type' => 'int',
				'unsigned' => true,
				'not null' => true,
				'default' => 0,
				'description' => 'Time spent, in milliseconds.',
			],
			'slowest' => [
				'type' => 'int',
				'unsigned' => true,
				'not null' => true,
				'default' => 0,
				'description' => 'Slowest single request, in milliseconds.',
			],
		],
		'primary key' => ['provider', 'day', 'operation'],
		'indexes' => ['day' => ['day']],
	];

	$schema['strata_placement'] = [
		'description' => 'Which storage tier holds which object, one row per copy.',
		'fields' => [
			'object_key' => [
				'type' => 'varchar_ascii',
				'length' => 255,
				'not null' => true,
				'description' => 'Object key, exactly as the bucket holds it.',
			],
			'tier' => [
				'type' => 'int',
				'size' => 'small',
				'unsigned' => true,
				'not null' => true,
				'description' => 'Tier index, zero being the nearest.',
			],
			'bytes' => [
				'type' => 'int',
				'size' => 'big',
				'unsigned' => true,
				'not null' => true,
				'default' => 0,
				'description' => 'The object size, so per-tier totals need no listing.',
			],
			'recorded' => [
				'type' => 'int',
				'not null' => true,
				'default' => 0,
				'description' => 'Unix timestamp this placement was written.',
			],
		],
		'primary key' => ['object_key', 'tier'],
		'indexes' => [
			'tier' => ['tier', 'object_key'],
			'recorded' => ['recorded'],
		],
	];

	$schema['strata_drill'] = [
		'description' => 'What each restore drill proved about the store.',
		'fields' => [
			'id' => [
				'type' => 'serial',
				'unsigned' => true,
				'not null' => true,
				'description' => 'Row id.',
			],
			'target' => [
				'type' => 'varchar_ascii',
				'length' => 64,
				'not null' => true,
				'description' => 'Commit the drill replayed against.',
			],
			'mode' => [
				'type' => 'varchar',
				'length' => 16,
				'not null' => true,
				'description' => 'How the drill compared, either replay or scratch.',
			],
			'verdict' => [
				'type' => 'varchar',
				'length' => 16,
				'not null' => true,
				'description' => 'One of pass, fail, inconclusive or refused.',
			],
			'matched' => [
				'type' => 'int',
				'unsigned' => true,
				'not null' => true,
				'default' => 0,
				'description' => 'Subjects the store reproduced exactly.',
			],
			'differed' => [
				'type' => 'int',
				'unsigned' => true,
				'not null' => true,
				'default' => 0,
				'description' => 'Subjects where the stored value and the live one disagree.',
			],
			'skipped' => [
				'type' => 'int',
				'unsigned' => true,
				'not null' => true,
				'default' => 0,
				'description' =>
					'Subjects that moved on after the replayed commit, so nothing was proved.',
			],
			'unreadable' => [
				'type' => 'int',
				'unsigned' => true,
				'not null' => true,
				'default' => 0,
				'description' => 'Subjects the store could not produce a value for.',
			],
			'sampled' => [
				'type' => 'int',
				'unsigned' => true,
				'not null' => true,
				'default' => 0,
				'description' => 'Subjects examined.',
			],
			'population' => [
				'type' => 'int',
				'unsigned' => true,
				'not null' => true,
				'default' => 0,
				'description' => 'Subjects the index held, so the sampled share is legible.',
			],
			'seconds' => [
				'type' => 'int',
				'unsigned' => true,
				'not null' => true,
				'default' => 0,
				'description' => 'How long the drill took, in milliseconds.',
			],
			'created' => [
				'type' => 'int',
				'not null' => true,
				'description' => 'Unix timestamp the drill ran.',
			],
			'detail' => [
				'type' => 'varchar',
				'length' => 500,
				'not null' => false,
				'description' => 'The summary line, bounded.',
			],
		],
		'primary key' => ['id'],
		'indexes' => [
			'created' => ['created'],
			'verdict' => ['verdict', 'created'],
		],
	];

	return $schema;
}

/**
 * Adds the tier placement index and the tiering defaults.
 *
 * The table is derived state like every other one here, so it is created empty and
 * `drush strata:reindex` fills it by listing each bucket. Tiering itself is left off: a site that
 * has been writing to one bucket keeps writing to one bucket, and a ladder nobody configured would
 * otherwise be a silent change to where history goes.
 */
function strata_update_11101(): string
{
	$schema = Drupal::database()->schema();
	$tables = strata_schema();

	if (!$schema->tableExists('strata_placement')) {
		$schema->createTable('strata_placement', $tables['strata_placement']);
	}

	$settings = Drupal::configFactory()->getEditable('strata.settings');

	if ($settings->get('tiers') === null) {
		$settings
			->set('tiers.enabled', false)
			->set('tiers.verify_copies', true)
			->set('tiers.levels', [])
			->save();
	}

	return (string) new TranslatableMarkup(
		'Added the tier placement index. Tiered storage is off; configure it at admin/config/system/strata/tiers.',
	);
}

/**
 * Adds the branch index and the merge parent column.
 *
 * Both are derived state, so both are created empty and `drush strata:reindex` fills them from the
 * bucket. Nothing existing changes address: a commit serializes its merge parent only when it has
 * one, so every commit written before this update hashes to exactly what it always did.
 */
function strata_update_11102(): string
{
	$schema = Drupal::database()->schema();
	$tables = strata_schema();

	if (!$schema->tableExists('strata_branch')) {
		$schema->createTable('strata_branch', $tables['strata_branch']);
	}
	if (!$schema->fieldExists('strata_commit', 'merge_parent')) {
		$schema->addField(
			'strata_commit',
			'merge_parent',
			$tables['strata_commit']['fields']['merge_parent'],
			['indexes' => ['merge_parent' => ['merge_parent']]],
		);
	}

	return (string) new TranslatableMarkup(
		'Added the branch index. Run drush strata:reindex to fill it from the bucket.',
	);
}

/**
 * Widens the journal sequence to a big integer.
 *
 * A serial never reuses a number, so the column climbs with every operation ever captured rather
 * than with the rows currently held. At the 800,000 operations a day a 500,000-user site writes,
 * a 32-bit serial runs out in about seven years, and the sequence is the journal's primary key.
 *
 * It also makes the type honest across drivers. `JournalInterface::trim()` takes a PHP int and
 * documents no ceiling, so `trim(PHP_INT_MAX)` is a legitimate way to say "everything"; against a
 * 32-bit column MySQL and SQLite coerce it silently and PostgreSQL refuses the statement outright.
 * Nothing pending is lost - the column is widened in place, not recreated.
 */
function strata_update_11103(): string
{
	$schema = Drupal::database()->schema();
	$tables = strata_schema();

	$schema->changeField(
		'strata_journal',
		'sequence',
		'sequence',
		$tables['strata_journal']['fields']['sequence'],
		['primary key' => ['sequence']],
	);

	return (string) new TranslatableMarkup('Widened the journal sequence to a 64-bit key.');
}

/**
 * Implements hook_requirements().
 *
 * Reports what the compression and encryption layers can actually do on this host, so a site
 * discovers a missing extension on the status report rather than at the first flush.
 */
function strata_requirements(string $phase): array
{
	$requirements = [];

	if ($phase !== 'runtime') {
		return $requirements;
	}

	$registry = CodecRegistry::withShippedCodecs();
	$profiles = CodecCatalog::profiles($registry);

	$usable = array_filter($profiles, static fn(CodecProfile $p): bool => $p->perFrame);
	$missing = array_filter($profiles, static fn(CodecProfile $p): bool => !$p->perFrame);

	$hasDictionary = $registry->dictionaryWriter() !== null;
	$usableIds = implode(', ', array_map(static fn(CodecProfile $p): string => $p->id, $usable));
	$missingIds = implode(', ', array_map(static fn(CodecProfile $p): string => $p->id, $missing));

	$requirements['strata_codecs'] = [
		'title' => new TranslatableMarkup('Strata compression'),
		'value' => new TranslatableMarkup('@codec on the flush path; usable: @usable', [
			'@codec' => $registry->writer()->id(),
			'@usable' => $usableIds ?: 'none',
		]),
		'severity' => $hasDictionary ? RequirementSeverity::OK : RequirementSeverity::Warning,
		'description' => $hasDictionary
			? new TranslatableMarkup('Delta coding is available.')
			: new TranslatableMarkup(
				'No dictionary-capable codec is available, so delta coding is off. Missing: @missing.',
				['@missing' => $missingIds ?: 'none'],
			),
	];

	$requirements['strata_sodium'] = [
		'title' => new TranslatableMarkup('Strata encryption'),
		'value' => extension_loaded('sodium')
			? new TranslatableMarkup('Available')
			: new TranslatableMarkup('Unavailable'),
		'severity' => extension_loaded('sodium')
			? RequirementSeverity::OK
			: RequirementSeverity::Error,
		'description' => extension_loaded('sodium')
			? new TranslatableMarkup('XChaCha20-Poly1305 is available through ext-sodium.')
			: new TranslatableMarkup('ext-sodium is not loaded, so frames cannot be encrypted.'),
	];

	return $requirements;
}

/**
 * Implements hook_uninstall().
 *
 * Runs before hook_schema()'s tables are dropped, so the three tables nothing in the bucket can
 * reproduce are written to the file system first. The object store itself is never touched: an
 * uninstall removes the local index, not the backups.
 */
function strata_uninstall(): void
{
	$directory = 'public://strata-uninstall-' . date('Ymd-His');
	$filesystem = Drupal::service('file_system');
	$database = Drupal::database();
	$logger = Drupal::logger('strata');

	try {
		$filesystem->prepareDirectory(
			$directory,
			$filesystem::CREATE_DIRECTORY | $filesystem::MODIFY_PERMISSIONS,
		);
	} catch (Throwable $e) {
		$logger->error('Cannot create %dir to export the Strata audit tables: %message', [
			'%dir' => $directory,
			'%message' => $e->getMessage(),
		]);

		return;
	}

	foreach (['strata_restore_log', 'strata_health', 'strata_drill'] as $table) {
		try {
			$rows = $database
				->select($table, 't')
				->fields('t')
				->execute()
				?->fetchAll(FetchAs::Associative);
			$path = $directory . '/' . $table . '.json';

			file_put_contents($path, (string) json_encode($rows ?? [], JSON_PRETTY_PRINT));
			$logger->notice('Exported %count rows of %table to %path before uninstall.', [
				'%count' => count($rows ?? []),
				'%table' => $table,
				'%path' => $path,
			]);
		} catch (Throwable $e) {
			$logger->error('Cannot export %table before uninstall: %message', [
				'%table' => $table,
				'%message' => $e->getMessage(),
			]);
		}
	}
}
