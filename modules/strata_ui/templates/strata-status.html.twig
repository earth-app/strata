{#
/**
 * @file
 * A compact status panel, used by the dashboard blocks and the toolbar.
 *
 * Available variables:
 * - rows: each label and value pair, already formatted.
 * - severity: one of ok, warn or error, deciding the panel colour.
 * - url: where the full report is.
 *
 * @ingroup themeable
 */
#}
<div class="strata strata-status strata-status--{{ severity }}">
	<dl class="strata-status__list">
		{% for row in rows %}
			<dt class="strata-status__label">{{ row.label }}</dt>
			<dd class="strata-status__value strata-status__value--{{ row.severity|default('ok') }}">
				{{ row.value }}
			</dd>
		{% endfor %}
	</dl>

	{% if url %}
		<a class="strata-status__more" href="{{ url }}">{{ 'Details'|t }}</a>
	{% endif %}
</div>
