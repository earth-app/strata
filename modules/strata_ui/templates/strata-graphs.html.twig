{#
/**
 * @file
 * The Strata graphs.
 *
 * Available variables:
 * - charts: one built series each, with its own axis and peak.
 * - window: the span drawn.
 * - flat_note: why two of the lines are drawn flat.
 * - timeline_url: where the timeline for this window is.
 * - empty: whether there is any history to draw.
 *
 * @ingroup themeable
 */
#}
<div class="strata strata-graphs">
	<nav class="strata-nav" aria-label="{{ 'Views'|t }}">
		<a class="strata-nav__link" href="{{ timeline_url }}">{{ 'Timeline'|t }}</a>
	</nav>

	{% if empty %}
		<p class="strata-empty">{{ 'There is no history to graph yet.'|t }}</p>
	{% else %}
		<p class="strata-note">{{ flat_note }}</p>

		{% for chart in charts %}
			<section class="strata-graph strata-graph--{{ chart.key }}">
				<h3 class="strata-graph__title">
					{{ chart.label }}
					<span class="strata-graph__latest">{{ chart.latest }}</span>
					<span class="strata-graph__peak">{{ 'peak @peak'|t({'@peak': chart.peak}) }}</span>
				</h3>

				{% if chart.flat %}
					<p class="strata-empty">
						{{ 'Every reading in this window is zero.'|t }}
					</p>
				{% else %}
					<svg
						class="strata-chart strata-chart--line"
						viewBox="{{ chart.view_box }}"
						role="img"
						aria-label="{{ '@label over time, peaking at @peak'|t({'@label': chart.label, '@peak': chart.peak}) }}"
					>
						{% for line in chart.gridlines %}
							<line
								class="strata-chart__gridline"
								x1="{{ line.x1 }}"
								y1="{{ line.y }}"
								x2="{{ line.x2 }}"
								y2="{{ line.y }}"
							/>
							<text
								class="strata-chart__axis"
								x="{{ line.x1 - 8 }}"
								y="{{ line.y + 4 }}"
								text-anchor="end"
							>{{ line.label }}</text>
						{% endfor %}

						{% if chart.area %}
							<path class="strata-chart__area" d="{{ chart.area }}" />
						{% endif %}

						<polyline class="strata-chart__line" points="{{ chart.points }}" />

						{% for dot in chart.dots %}
							<circle class="strata-chart__dot" cx="{{ dot.x }}" cy="{{ dot.y }}" r="2">
								<title>{{ dot.label }}</title>
							</circle>
						{% endfor %}
					</svg>
				{% endif %}
			</section>
		{% endfor %}
	{% endif %}
</div>
