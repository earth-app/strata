{#
/**
 * @file
 * The configuration branches this site holds, and where each one points.
 *
 * Available variables:
 * - branches: one row per branch, the trunk included.
 * - empty: whether nothing but the trunk exists.
 * - realm: the realm a branch carries.
 * - realm_note: why a branch carries that realm and no other.
 * - flush_note: how to put configuration onto a branch.
 * - timeline_url: back to the timeline.
 *
 * @ingroup themeable
 */
#}
<div class="strata strata-branches">
	<p class="strata-note">{{ realm_note }}</p>

	{% if empty %}
		<p class="strata-empty">
			{{ 'No branch has been cut yet, so the trunk is the only line of history.'|t }}
		</p>
	{% endif %}

	<table class="strata-table">
		<thead>
			<tr>
				<th>{{ 'Branch'|t }}</th>
				<th>{{ 'Ref'|t }}</th>
				<th>{{ 'Forked From'|t }}</th>
				<th>{{ 'Tip'|t }}</th>
				<th>{{ 'Created'|t }}</th>
				<th>{{ 'Action'|t }}</th>
			</tr>
		</thead>
		<tbody>
			{% for branch in branches %}
				<tr class="strata-branches__row{{ branch.trunk ? ' strata-branches__row--trunk' : '' }}">
					<td>
						<strong>{{ branch.name }}</strong>
						{% if branch.trunk %}
							<span class="strata-badge">{{ 'Trunk'|t }}</span>
						{% endif %}
					</td>
					<td><code>{{ branch.ref }}</code></td>
					<td><code>{{ branch.forked_from }}</code></td>
					<td><code>{{ branch.tip }}</code></td>
					<td>{{ branch.created }}</td>
					<td>
						{% if branch.merge_url %}
							<a href="{{ branch.merge_url }}">{{ 'Merge'|t }}</a>
						{% elseif branch.trunk %}
							<span class="strata-manual">{{ 'Merged into'|t }}</span>
						{% else %}
							<span class="strata-manual">{{ 'Nothing to merge'|t }}</span>
						{% endif %}
					</td>
				</tr>
			{% endfor %}
		</tbody>
	</table>

	<p class="strata-note">{{ flush_note }}</p>

	<nav class="strata-nav">
		<a class="strata-nav__link" href="{{ timeline_url }}">{{ 'Timeline'|t }}</a>
	</nav>
</div>
