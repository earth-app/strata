{#
/**
 * @file
 * Open findings, repair rungs and what the last drill proved.
 *
 * Available variables:
 * - findings: one row per open code.
 * - counts: how many codes are open at each severity.
 * - clean: whether there is nothing open.
 * - drills: the newest drill and the recent verdicts.
 * - anomalies: what departed from this site's own history.
 * - automatic_note: which rungs cron may run.
 * - verify_note: what nothing on this page can notice on its own.
 * - timeline_url: back to the timeline.
 *
 * @ingroup themeable
 */
#}
<div class="strata strata-health">
	<div class="strata-summary" role="group" aria-label="{{ 'Open findings by severity'|t }}">
		{% for name, count in counts %}
			<div class="strata-summary__item strata-summary__item--{{ name|lower }}">
				<span class="strata-summary__label">{{ name }}</span>
				<span class="strata-summary__value">{{ count }}</span>
			</div>
		{% endfor %}
	</div>

	<section class="strata-drill">
		<h3>{{ 'Restore Drills'|t }}</h3>
		{% if drills.ran %}
			<p class="strata-drill__verdict strata-drill__verdict--{{ drills.verdict }}">
				<strong>{{ drills.verdict }}</strong> {{ drills.detail }}
				<span class="strata-drill__when">{{ drills.when }}</span>
			</p>
			<ul class="strata-drill__history">
				{% for verdict, count in drills.verdicts %}
					<li>{{ verdict }}: {{ count }}</li>
				{% endfor %}
			</ul>
		{% else %}
			<p class="strata-empty">{{ drills.note }}</p>
		{% endif %}
	</section>

	{% if anomalies is not empty %}
		<section class="strata-anomalies">
			<h3>{{ 'Departures From This Site\'s Own History'|t }}</h3>
			<ul>
				{% for anomaly in anomalies %}
					<li class="strata-anomaly strata-anomaly--{{ anomaly.severity }}">
						{{ anomaly.describe }}
					</li>
				{% endfor %}
			</ul>
		</section>
	{% endif %}

	<section class="strata-findings">
		<h3>{{ 'Open Findings'|t }}</h3>
		{% if clean %}
			<p class="strata-empty">{{ 'Nothing is open.'|t }}</p>
		{% else %}
			<table class="strata-table">
				<thead>
					<tr>
						<th>{{ 'Severity'|t }}</th>
						<th>{{ 'Code'|t }}</th>
						<th>{{ 'Scopes'|t }}</th>
						<th>{{ 'Rung'|t }}</th>
						<th>{{ 'Newest'|t }}</th>
						<th>{{ 'Action'|t }}</th>
					</tr>
				</thead>
				<tbody>
					{% for finding in findings %}
						<tr class="strata-findings__row strata-findings__row--{{ finding.severity_name|lower }}">
							<td>
								<span class="strata-badge strata-badge--{{ finding.severity_name|lower }}">
									{{ finding.severity_name }}
								</span>
							</td>
							<td><code>{{ finding.code }}</code></td>
							<td>{{ finding.scopes }}</td>
							<td>{{ finding.rung }}</td>
							<td>{{ finding.newest }}</td>
							<td>
								{% if finding.repair_url %}
									<a href="{{ finding.repair_url }}">{{ 'Repair'|t }}</a>
								{% else %}
									<span class="strata-manual">{{ 'Needs a person'|t }}</span>
								{% endif %}
							</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		{% endif %}
	</section>

	<p class="strata-note">{{ automatic_note }}</p>
	<p class="strata-note">{{ verify_note }}</p>

	<nav class="strata-nav">
		<a class="strata-nav__link" href="{{ timeline_url }}">{{ 'Timeline'|t }}</a>
	</nav>
</div>
