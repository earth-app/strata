{#
/**
 * @file
 * Whether this site is backed up right now, and what to do when it is not.
 *
 * Available variables:
 * - capturing: whether capture is switched on.
 * - verdict: the one sentence at the top.
 * - severity: ok, warn or error, deciding the banner colour.
 * - requirements: this module's rows on Drupal's status report.
 * - figures: the cards saying how much work is protected.
 * - findings: how many codes are open at each severity.
 * - drill: what the newest restore drill proved.
 * - setup: the ordered setup steps, empty once every one of them is done.
 * - links: where to go next.
 * - unavailable: why the local indexes could not be read, when they could not.
 *
 * @ingroup themeable
 */
#}
<div class="strata strata-overview">
	<p class="strata-banner strata-banner--{{ severity }}">{{ verdict }}</p>

	{% if setup is not empty %}
		<section class="strata-section strata-setup">
			<h3 class="strata-section__title">{{ 'Getting Started'|t }}</h3>
			<ol class="strata-setup__steps">
				{% for step in setup %}
					<li class="strata-setup__step strata-setup__step--{{ step.done ? 'done' : 'todo' }}">
						<span class="strata-setup__title">
							{% if step.url and not step.done %}
								<a href="{{ step.url }}">{{ step.title }}</a>
							{% else %}
								{{ step.title }}
							{% endif %}
						</span>
						<span class="strata-setup__detail">{{ step.detail }}</span>
					</li>
				{% endfor %}
			</ol>
		</section>
	{% endif %}

	{% if unavailable %}
		<p class="strata-warning">
			{{ 'The local indexes could not be read: @why'|t({'@why': unavailable}) }}
		</p>
	{% endif %}

	{% if figures is not empty %}
		<div class="strata-cards" role="group" aria-label="{{ 'How much work is protected'|t }}">
			{% for figure in figures %}
				<div class="strata-card strata-card--{{ figure.severity }}">
					<span class="strata-card__label">{{ figure.label }}</span>
					<span class="strata-card__value{{ figure.wide ? ' strata-card__value--long' : '' }}">
						{{ figure.value }}
					</span>
					<span class="strata-card__note">{{ figure.note }}</span>
				</div>
			{% endfor %}
		</div>
	{% endif %}

	<section class="strata-section">
		<h3 class="strata-section__title">{{ 'Checks'|t }}</h3>
		<table class="strata-table">
			<thead>
				<tr>
					<th>{{ 'Check'|t }}</th>
					<th>{{ 'Result'|t }}</th>
					<th>{{ 'Detail'|t }}</th>
				</tr>
			</thead>
			<tbody>
				{% for requirement in requirements %}
					<tr class="strata-table__row--{{ requirement.severity }}">
						<th scope="row">{{ requirement.title }}</th>
						<td>
							<span class="strata-badge strata-badge--{{ requirement.severity }}">
								{{ requirement.verdict }}
							</span>
							{{ requirement.value }}
						</td>
						<td>{{ requirement.description }}</td>
					</tr>
				{% endfor %}
			</tbody>
		</table>
	</section>

	<section class="strata-section">
		<h3 class="strata-section__title">{{ 'Health'|t }}</h3>
		{% if findings is empty %}
			<p class="strata-empty">{{ 'No finding is open.'|t }}</p>
		{% else %}
			<ul class="strata-tally">
				{% for finding in findings %}
					<li>
						<span class="strata-badge strata-badge--{{ finding.name|lower }}">
							{{ finding.name }}
						</span>
						{{ finding.count }}
					</li>
				{% endfor %}
			</ul>
		{% endif %}

		{% if drill.ran %}
			<p class="strata-drill__verdict strata-drill__verdict--{{ drill.verdict|lower }}">
				<strong>{{ drill.verdict }}</strong> {{ drill.detail }}
				<span class="strata-drill__when">{{ drill.when }}</span>
			</p>
		{% else %}
			<p class="strata-empty">
				{{ 'Nothing has proved a restore works here yet. Run a drill to turn that claim into a measurement.'|t }}
			</p>
		{% endif %}
	</section>

	{% if links is not empty %}
		<section class="strata-section">
			<h3 class="strata-section__title">{{ 'Where to Go Next'|t }}</h3>
			<ul class="strata-links">
				{% for link in links %}
					<li class="strata-links__item">
						<a class="strata-links__link" href="{{ link.url }}">{{ link.title }}</a>
						<span class="strata-links__description">{{ link.description }}</span>
					</li>
				{% endfor %}
			</ul>
		</section>
	{% endif %}
</div>
