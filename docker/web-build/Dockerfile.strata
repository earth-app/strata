ARG BASE_IMAGE
FROM $BASE_IMAGE

ARG DDEV_PHP_VERSION

ENV DEBIAN_FRONTEND=noninteractive

# the codec registry probes for these; without them the playground quietly falls back to gzip and
# none of the measured compression numbers can be reproduced by hand. the CLI binaries are what
# ZstdPipe falls back to when the extension is absent, so both paths stay drivable
#
# confold keeps ddev's own php-fpm.conf: pulling php-dev upgrades the php packages, and the
# conffile prompt that raises is what makes an interactive apt exit 100 inside a build
RUN apt-get update \
	&& apt-get install -y --no-install-recommends \
		-o Dpkg::Options::=--force-confdef \
		-o Dpkg::Options::=--force-confold \
		"php${DDEV_PHP_VERSION}-zstd" \
		"php${DDEV_PHP_VERSION}-dev" \
		php-pear \
		make \
		libbrotli-dev \
		zstd \
		brotli \
	&& rm -rf /var/lib/apt/lists/*

# no debian package ships the brotli extension, so it is built from pecl; the empty answers accept
# its defaults, which build against the bundled libbrotli
RUN yes '' | pecl install brotli \
	&& echo "extension=brotli.so" > "/etc/php/${DDEV_PHP_VERSION}/mods-available/brotli.ini" \
	&& phpenmod -v "${DDEV_PHP_VERSION}" -s ALL brotli
