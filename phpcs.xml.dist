<?xml version="1.0" ?>
<ruleset name="earth-app-strata">
	<description>
		Drupal coding standards, minus every sniff that fights this repo's layout.
	</description>

	<file>src</file>
	<file>modules</file>
	<file>tests</file>
	<file>stubs</file>
	<arg name="extensions" value="php,module,install,inc" />
	<arg value="sp" />
	<arg name="colors" />

	<rule ref="Drupal">
		<!-- comment house style: lowercase, no trailing period -->
		<exclude name="Drupal.Commenting.InlineComment.NotCapital" />
		<exclude name="Drupal.Commenting.InlineComment.InvalidEndChar" />

		<!-- layout sniffs lose to the house style: tabs at 4, 100 cols, brace on its own line -->
		<exclude name="Generic.PHP.UpperCaseConstant.Found" />
		<exclude name="Generic.WhiteSpace.DisallowTabIndent" />
		<exclude name="Drupal.WhiteSpace.ScopeIndent" />
		<exclude name="Drupal.WhiteSpace.ObjectOperatorIndent" />
		<exclude name="Drupal.WhiteSpace.ScopeClosingBrace" />
		<exclude name="Drupal.Arrays.Array.ArrayIndentation" />
		<exclude name="Drupal.Classes.ClassDeclaration.BraceOnNewLine" />
		<exclude name="Drupal.Classes.ClassDeclaration.CloseBraceAfterBody" />
		<exclude name="Drupal.Functions.MultiLineFunctionDeclaration.BraceOnNewLine" />
		<exclude name="Drupal.Functions.MultiLineFunctionDeclaration.Indent" />
		<exclude name="Drupal.ControlStructures.ControlSignature.NewlineAfterCloseBrace" />
		<exclude name="Squiz.WhiteSpace.FunctionSpacing.AfterLast" />
		<exclude name="Squiz.WhiteSpace.FunctionSpacing.BeforeFirst" />
		<exclude name="Drupal.Classes.UseGlobalClass.RedundantUseStatement" />

		<!--
			demands a leading-backslash FQN in @param/@return/@throws. this repo imports every class
			with `use` and refers to the short name everywhere including docblocks, so the sniff can
			never pass without reversing that rule.
		-->
		<exclude name="Drupal.Commenting.DataTypeNamespace" />

		<!-- #region / #endregion folding markers read as perl comments to this sniff -->
		<exclude name="Drupal.Commenting.InlineComment.WrongStyle" />

		<!--
			requires PascalCase enum cases as drupal core uses. this repo uses SCREAMING_SNAKE_CASE to
			match the enums in mantle2, which is the style reference for the family.
		-->
		<exclude name="Drupal.NamingConventions.ValidEnumCase" />

		<!--
			fires on a class imported only so a docblock can name it by its short form. the house rule
			requires that import, so "unused" here means "used exactly as intended".
		-->
		<exclude name="Drupal.Classes.UnusedUseStatement" />

		<!--
			wants `foreach ($x as $y)` on one line. prettier breaks a long foreach across lines and
			puts `as $y` on its own, and prettier is what formats this repo's php.
		-->
		<exclude name="Squiz.ControlStructures.ForEachLoopDeclaration.SpacingBeforeAs" />

		<!--
			wants `new class () {}`. prettier removes the empty argument list from an anonymous class
			declaration, so the two rules cannot both be satisfied.
		-->
		<exclude name="Drupal.Classes.ClassCreateInstance.ParenthesisMissing" />
	</rule>

	<rule ref="DrupalPractice" />

	<!--
		the house limit is 100 and prettier enforces it. prettier measures a docblock line the way a
		reader sees it and accounts for the leading ` * `; this sniff counts raw characters, so it
		reports lines prettier has already decided are correct. 10 characters of headroom is the
		difference between the two measurements: anything past 110 is a line prettier would have
		wrapped, so it is still reported
	-->
	<rule ref="Drupal.Files.LineLength">
		<properties>
			<property name="lineLimit" value="110" />
		</properties>
	</rule>

	<!--
		a stub declares a class that belongs to a php extension, so its name is fixed by that
		extension and can neither carry this project's prefix nor be renamed to match a filename that
		sits alongside the function-only stubs.
	-->
	<rule ref="Drupal.Classes.ClassFileName.NoMatch">
		<exclude-pattern>stubs/*</exclude-pattern>
	</rule>
	<rule ref="DrupalPractice.General.ClassName.ClassPrefix">
		<exclude-pattern>stubs/*</exclude-pattern>
	</rule>

	<rule ref="Drupal.Commenting.FunctionComment.Missing">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="Drupal.Commenting.ClassComment.Missing">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="Drupal.Commenting.DocComment.MissingShort">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="Drupal.Commenting.FunctionComment.MissingReturnComment">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<!--
		with no docblock on a test method the closest comment is the #region marker above it, which
		this sniff reads as a malformed function comment. src/ methods all carry a real docblock, so
		the sniff still has something to check there.
	-->
	<rule ref="Drupal.Commenting.FunctionComment.WrongStyle">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<!--
		reads a one-letter word inside a camelCase name as two consecutive capitals, so a correct
		name such as onlyUnclassifiedNeedsADecision is reported. test method names come from the
		#[TestDox] sentence; src/ keeps the sniff.
	-->
	<rule ref="Drupal.NamingConventions.ValidFunctionName.ScopeNotCamelCaps">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
</ruleset>
